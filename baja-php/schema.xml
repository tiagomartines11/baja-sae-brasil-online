  <table name="participantes" idMethod="native" phpName="Participante">
    <column name="nome" phpName="Nome" type="VARCHAR" size="300"/>
    <column name="funcao" phpName="Funcao" type="VARCHAR" size="45"/>
    <!-- CPF, zero-padded to 11. A string, not a number: a CPF is an
         identifier, and storing it as BIGINT is what made dechex() the
         obvious way to build a URL out of one and produced this whole work
         package. It also destroyed every leading zero on the way in, and
         made "no document on record" indistinguishable from the value 0.
         Format is enforced by a CHECK constraint added in the migration —
         Propel's schema has no element for one — and deliberately not the
         check digits: historical rows include CPFs mistyped at registration
         and they must stay valid rows. -->
    <column name="cpf" phpName="Cpf" type="CHAR" size="11">
      <vendor type="mysql">
        <parameter name="Charset" value="ascii"/>
      </vendor>
    </column>
    <!-- Passport or other non-CPF document, stored verbatim. Never padded:
         padding is only reversible when the length is known, which is true
         of a CPF and false of a passport, so a padded passport number can
         never be told from one with a real leading zero.
         Permissive on purpose — Brazilian passports are two letters and six
         digits, and the digits-only convention this column exists to end is
         a data-entry habit, not a fact about passports. utf8mb4 so that a
         future document form needs no further migration, and because it
         matches the connection charset. -->
    <column name="documento_estrangeiro" phpName="DocumentoEstrangeiro" type="VARCHAR" size="32">
      <vendor type="mysql">
        <parameter name="Charset" value="utf8mb4"/>
        <parameter name="Collate" value="utf8mb4_unicode_ci"/>
      </vendor>
    </column>
    <column name="evento" phpName="EventoId" type="CHAR" size="4" required="true"/>
    <!-- Public certificate identifier: 16 random bytes, base64url, unpadded,
         and the primary key.
         ascii_bin is load-bearing, not tidiness. base64url is case-sensitive,
         and the table default is latin1_swedish_ci, under which the key would
         treat "aB" and "Ab" as the same token and a lookup would resolve to
         the wrong participant's certificate. -->
    <column name="token" phpName="Token" type="CHAR" size="22" primaryKey="true" required="true">
      <vendor type="mysql">
        <parameter name="Charset" value="ascii"/>
        <parameter name="Collate" value="ascii_bin"/>
      </vendor>
    </column>
    <!-- Audit trail. Who asserted this record, when, and as part of which
         paste. Existing rows carry NULL in all three and are not backfilled:
         there is nothing to backfill from.

         In the table rather than the access log because the two have
         different lifetimes. Logs rotate on a deliberately short schedule
         under the retention principle this system already adopted, while
         certificate rows are kept indefinitely — and an audit trail that
         expires before the artifact it describes is not an audit trail. A
         certificate is a claim SAE makes about a person; when one is
         disputed the question is who made the claim, and that is a property
         of the record. LGPD Art. 37. -->
    <column name="criado_por" phpName="CriadoPor" type="INTEGER"/>
    <!-- DATETIME, not TIMESTAMP. TIMESTAMP is stored as an offset from the
         epoch and rendered through the session timezone, so the same row
         reads as a different instant if the server's timezone is ever
         changed — and it runs out in 2038, which is inside the period these
         rows are kept for. Neither is acceptable for a record whose whole
         purpose is to say when something was asserted. -->
    <column name="criado_em" phpName="CriadoEm" type="TIMESTAMP" sqlType="DATETIME"/>
    <!-- Batch identifier, shared by every row of one paste. Same generator as
         `token`, and so the same collation reasoning: base64url is
         case-sensitive, and under the table default (latin1_swedish_ci) two
         batches whose ids differ only in case would be one batch to a
         WHERE clause — which is how a deletion by lote_id would take rows it
         was not meant to. -->
    <column name="lote_id" phpName="LoteId" type="CHAR" size="22">
      <vendor type="mysql">
        <parameter name="Charset" value="ascii"/>
        <parameter name="Collate" value="ascii_bin"/>
      </vendor>
    </column>
    <!-- Voiding. A certificate issued in error stops being valid without the
         row being destroyed, because destroying it would take the audit trail
         with it — and this action reaches certificates issued years ago, which
         somebody may already hold. Whoever voided it and why are the first two
         questions anybody asks afterwards, so they are on the record rather
         than in a log that rotates.

         Distinct from deleting a lote, which really does remove rows: that
         exists to undo a paste minutes old, where nothing has been issued to
         anybody yet. These two are different actions with different meanings
         and the interface names them differently.

         A voided row is excluded from /verificar, from /buscar, and from
         duplicate detection — so the same certificate can be issued again
         afterwards, which is usually the point of voiding one. -->
    <column name="anulado_em" phpName="AnuladoEm" type="TIMESTAMP" sqlType="DATETIME"/>
    <column name="anulado_por" phpName="AnuladoPor" type="INTEGER"/>
    <!-- Required by the interface, nullable in the schema: existing rows have
         no reason because they are not voided. latin1 like every other text
         column here, so the same character-set check applies to it. -->
    <column name="anulado_motivo" phpName="AnuladoMotivo" type="VARCHAR" size="255"/>
    <foreign-key foreignTable="evento" name="participantes_evento_id" onDelete="CASCADE" onUpdate="CASCADE">
      <reference local="evento" foreign="evento_id"/>
    </foreign-key>
    <!-- SET NULL, never CASCADE. admin_usuario.php deletes the user row when
         a user is left with no meaningful permissions, so CASCADE here would
         mean that de-permissioning somebody deletes every certificate they
         ever issued. Losing the attribution is bad; losing the certificates
         is unrecoverable. -->
    <foreign-key foreignTable="user" name="participantes_criado_por" onDelete="SETNULL" onUpdate="CASCADE">
      <reference local="criado_por" foreign="user_id"/>
    </foreign-key>
    <foreign-key foreignTable="user" name="participantes_anulado_por" onDelete="SETNULL" onUpdate="CASCADE">
      <reference local="anulado_por" foreign="user_id"/>
    </foreign-key>
    <index name="participantes_evento_id_idx">
      <index-column name="evento"/>
    </index>
    <!-- What makes a bad paste identifiable, and deletable, afterwards. -->
    <index name="participantes_lote_id_idx">
      <index-column name="lote_id"/>
    </index>
    <index name="participantes_criado_por_idx">
      <index-column name="criado_por"/>
    </index>
    <!-- Declared rather than left to Propel, which needs an index on a foreign
         key column and otherwise invents one called `fi_ticipantes_anulado_por`
         — a truncation, and not a name anybody would look for. -->
    <index name="participantes_anulado_por_idx">
      <index-column name="anulado_por"/>
    </index>
    <!-- No index on anulado_em, deliberately. Every query filtering on it
         either resolves a single row by primary key first (/verificar) or is
         already a scan for want of an index on the searchable columns
         (/buscar, the admin lookup), so one here would earn nothing. -->
    <vendor type="mysql">
      <parameter name="Engine" value="InnoDB"/>
    </vendor>
  </table>
