<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for the lap counting tests.

  Two suites, because they need different things:

    engine   Pure logic. Needs nothing but PHP, so it runs anywhere,
             including CI:
                 vendor/bin/phpunit --testsuite engine

    db       Exercises the upload endpoint, the score publisher and the
             counter links against a real MySQL. Run it inside the dev
             container, where the database and Redis are reachable:
                 docker compose exec -e BAJA_TEST_DB=1 baja-app \
                     vendor/bin/phpunit --testsuite db
             Without BAJA_TEST_DB=1 every test in it is skipped, so that
             nobody writes test rows into a database by accident. Never set
             it against production.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Contagem/bootstrap.php"
         cacheResult="false"
         colors="true">
    <testsuites>
        <testsuite name="engine">
            <directory>tests/Contagem/Engine</directory>
        </testsuite>
        <testsuite name="db">
            <directory>tests/Contagem/Db</directory>
        </testsuite>
    </testsuites>
</phpunit>
