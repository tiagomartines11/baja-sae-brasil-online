<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration.

  Three suites, because they need different things:

    engine   Lap counting engine. Pure logic. Needs nothing but PHP, so it
             runs anywhere, including CI.

    unit     Small helper functions from the rest of the site (judge pages
             and so on). Like engine, they need nothing but PHP and run in CI.

    db       Exercises the upload endpoint, the score publisher and the
             counter links against a real MySQL. Run it inside the dev
             container, where the database and Redis are reachable, with
             the environment variable BAJA_TEST_DB set to 1. Without it
             every test in the suite is skipped, so that nobody writes test
             rows into a database by accident. Never set it against
             production.

  The exact commands are in docs/contagem.md, "Tests". They are not repeated
  here because an XML comment cannot contain two hyphens in a row, which
  every command-line option has.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Contagem/bootstrap.php"
         cacheResult="false"
         colors="true">
    <testsuites>
        <testsuite name="engine">
            <directory>tests/Contagem/Engine</directory>
        </testsuite>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="db">
            <directory>tests/Contagem/Db</directory>
        </testsuite>
        <!--
          Results regression snapshots (docs/results-snapshots.md).
          results-snapshot      the tool itself, on made-up pages; no database.
          results-snapshot-db   proves the tool writes nothing; needs the app's
                                database variables, skipped without them.
        -->
        <testsuite name="results-snapshot">
            <directory>tests/ResultsSnapshot/Unit</directory>
        </testsuite>
        <testsuite name="results-snapshot-db">
            <directory>tests/ResultsSnapshot/Db</directory>
        </testsuite>
        <!--
          The resultado config check (docs/results-config-check.md), run on the
          dev seed: writes nothing, finds the known broken configs. Needs the
          app's database variables, skipped without them. FatalFormulaTest also
          needs BAJA_TEST_DB set to 1, because it loads a made-up event first.
          Its unit tests are in tests/Unit/ResultsCheck, part of the unit suite.
        -->
        <testsuite name="results-check-db">
            <directory>tests/ResultsCheck/Db</directory>
        </testsuite>
        <!--
          The formula engine comparison (docs/formula-engine.md) on the dev
          seed: no formula differs, nothing is written. Needs the app's
          database variables, skipped without them. CompareFixtureTest also
          needs BAJA_TEST_DB set to 1, because it loads a made-up event first.
          The engines' own tests are in tests/Unit/Formula, part of the unit
          suite.
        -->
        <testsuite name="formula-compare-db">
            <directory>tests/FormulaCompare/Db</directory>
        </testsuite>
        <!--
          Prova totals ($Xmax, $Xcount...) worked out by a real save, on a
          made-up event that the test inserts and deletes. Needs the app's
          database variables and BAJA_TEST_DB set to 1; skipped without them.
        -->
        <testsuite name="prova-db">
            <directory>tests/Prova/Db</directory>
        </testsuite>
        <!--
          The public results API (docs/results-api.md) on the dev seed: every
          table equals the results builder's public one, spoilers included;
          the tournament and the lap-counted prova are well formed; unknown
          ids give 404. Read-only. Needs the app's database variables,
          skipped without them. Its unit tests are in tests/Unit/Api, part
          of the unit suite.
        -->
        <testsuite name="results-api-db">
            <directory>tests/Api/Resultados/Db</directory>
        </testsuite>
        <!--
          The event archive queue (BAJAAPP-67): what ticking and unticking
          "Finalizado?" in juiz/evento.php records, and how the nightly job
          consumes it. Writes a made-up event and its queue rows, so it needs
          BAJA_TEST_DB set to 1 and the app's database variables; skipped
          without them. The packaging and upload half is tested by
          baja-infra/tests/backup/run-tests.sh.
        -->
        <testsuite name="results-archive-db">
            <directory>tests/ResultsArchive/Db</directory>
        </testsuite>
    </testsuites>
</phpunit>
