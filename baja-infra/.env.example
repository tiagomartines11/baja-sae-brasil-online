# Baja SAE Brasil — environment configuration for the docker compose stack.
#
# Quick start:
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Edit it locally; commit only changes to this template.
# The dev defaults below work out of the box for `docker compose up -d`.
# In prod, replace with real production values.
#
# Keep comments on their own line, never trailing an assignment. Compose's
# .env parser only strips a trailing comment when whitespace precedes the `#`:
# `FOO=bar # note` yields `bar`, but `FOO=bar# note` yields the literal
# `bar# note`. Bash's `source` strips neither the same way, so a trailing
# comment can read as correct in a shell and be wrong inside the container,
# and the whitespace rule has varied across Compose versions. A comment on its
# own line above the assignment sidesteps all of it.

# ----- Stack environment -----
ENV=dev

# ----- Public-facing domain -----
# What URL the PHP app builds public links from (e.g. cert PDFs).
# In prod: bajasaebrasil.net + https.
BAJA_PUBLIC_DOMAIN=baja.local
BAJA_PUBLIC_SCHEME=http

# ----- phpBB cookie domains -----
# Leading-dot form required to share auth cookies across subdomains.
# Applied by the migration script after each DB import.
BAJA_COOKIE_DOMAIN=.baja.local
FORMULA_COOKIE_DOMAIN=.formula.local

# ----- Code path bind mount -----
# Path to baja-php source tree, relative to baja-infra/. Different if you
# checked the repo out somewhere unusual.
BAJA_APP_PATH=../baja-php

# ----- MySQL credentials -----
# Root password is used by the MySQL container init only. Application-level
# users have their own passwords below.
MYSQL_ROOT_PASSWORD=devrootpass

# `resultados` is the MySQL user the baja-app container connects as. It has
# full grants on baja_resultados AND read access on phpbb_baja (used by the
# session shim — see baja-php/src/Baja/Auth/SessionStore.php). One MySQL
# account, two roles. Compose injects this single value into both
# MYSQL_RESULTADOS_PASSWORD (init-script grants) and PHPBB_DB_PASS (shim
# read path); they're the same secret.
MYSQL_RESULTADOS_PASSWORD=devresultados

# Per-phpBB-instance MySQL users. Each phpBB container connects to its own
# DB as its own user.
#
# config.php is generated at container boot from config.php.template
# (baja-infra/phpbb-baja/ and .../phpbb-formula/) using envsubst, reading
# these values from the live environment. Changing either password below
# only requires recreating the volume — no image rebuild needed:
#     docker compose down -v
#     docker compose up -d
#
MYSQL_PHPBB_BAJA_PASSWORD=devphpbbbaja2
MYSQL_PHPBB_FORMULA_PASSWORD=devphpbbformula2

# ----- phpBB cookie prefixes -----
# The prefix phpBB uses when setting its cookies (<prefix>_sid, _u, _k).
# The migration's patch phase normalizes each forum's DB cookie_name to
# these values (production's imported cookie_name is an incidental random
# string that would otherwise break the baja-app session shim, which reads
# the cookie named by PHPBB_COOKIE_PREFIX). Keep these stable across envs.
# baja forum (also read by the shim)
PHPBB_COOKIE_PREFIX=phpbb3_baja
# formula forum
PHPBB_FORMULA_COOKIE_PREFIX=phpbb3_formula

# Cache TTL for the shim's per-session lookup. Higher = fewer DB queries;
# trade-off is staleness window (admin-killed sessions keep validating
# until expiry). 600s balances this for our threat model (was 60s in
# WP6, bumped here as the team's reassessed call).
SESSION_CACHE_TTL_SECONDS=600

# ----- phpBB auth extension (baja/auth, lives in phpbb-baja) -----
# Suffix the extension accepts as a valid post-login redirect target.
# Anything not ending with this is rejected as off-domain.
BAJA_AUTH_ALLOWED_DOMAIN_SUFFIX=.baja.local

# Where login lands when the redirect param is missing or rejected.
BAJA_AUTH_DEFAULT_REDIRECT=http://baja.local/

# ----- App secrets (baja-app) -----
# Real values required in prod (OneSignal push auth, reCAPTCHA site key,
# the remote key, notification emails). Dev can use any placeholder — these
# code paths are not exercised in dev.
ONESIGNAL_AUTH=
REMOTE_KEY=
RECAPTCHA_KEY=
SYSADMIN_1_EMAIL=
SYSADMIN_2_EMAIL=

# ----- API foundation (baja-app, api.* vhost) -----
# Exact-match CORS whitelist for the PHP API, comma-separated. No patterns,
# no wildcards, and an empty value allows nothing — it fails closed.
#
# This is not optional. The API is on its own subdomain (api.baja.local) per
# the *.domain = PHP convention, so every call from the frontend is
# cross-origin. An empty list means the browser blocks all of them.
#
# Exact origins rather than a wildcard is forced by the spec: Cors sends
# Access-Control-Allow-Credentials so the phpBB session cookie flows, and
# credentialed requests may not be paired with `*`.
#
# Dev defaults below cover the local subdomains. In prod:
#   https://bajasaebrasil.com.br,https://www.bajasaebrasil.com.br
API_CORS_ORIGINS=http://baja.local,http://www.baja.local,http://resultados.baja.local,http://juiz.baja.local,http://fila.baja.local

# Master key for Baja\Util\Encryption (libsodium secretbox), base64 of 32
# random bytes. Generate with:
#     php -r "echo base64_encode(random_bytes(32));"
# Required in prod. Unset in dev until a feature actually encrypts something —
# Encryption throws rather than falling back to a default key, by design.
# Rotating this makes every existing ciphertext undecryptable; there is no
# key-versioning scheme yet, so treat it as write-once until FP8 adds one.
STORAGE_ENCRYPTION_KEY=

# Minimum log level for Baja\Logger: debug|info|notice|warning|error|critical.
# Blank uses the environment default (debug in dev, info in prod). Records go
# to stdout as JSON — read them with `docker compose logs baja-app`.
LOG_LEVEL=

# ----- phpBB cron sidecar (staging/prod overlay) -----
# How often the cron sidecars run phpBB's periodic tasks. Email queue
# latency is at most this interval. 300s (5 min) is a sensible default.
CRON_INTERVAL_SECONDS=300

# ----- Tailscale (prod DB access) -----
# The VM's Tailscale interface IP (100.x.y.z). MySQL's 3306 is published
# here in prod so tailnet members can reach it; the public interface never
# sees it. Leave blank in dev (override isn't used there).
TAILSCALE_IP=

# ----- Encrypted database backups (`backup` service, tools profile) -----
#
# Full documentation, including how to restore, lives in
# baja-infra/docs/backup-restore.md. Read it before changing anything here.
#
# The restricted MySQL user backup-db.sh connects as. Created by
# mysql/init/02-create-users.sh on FIRST BOOT ONLY — on an already
# initialised server (production) the GRANT has to be applied by hand;
# the runbook has the exact statement. It has no write privilege on any
# database, by design.
MYSQL_BACKUP_USER=backup
MYSQL_BACKUP_PASSWORD=devbackup

# Path on the HOST to the baja-backup-writer service-account key.
#
# Note this variable is used two ways: compose bind-mounts this host path
# into the container, where the same variable name is set to the fixed
# in-container path (/run/secrets/gdrive-backup-writer.json). You only
# ever set the host side here.
#
# baja-backup-writer must be a CONTRIBUTOR on the Shared Drive — able to
# upload, unable to trash. That property is what stops a compromised VPS
# from deleting the backups it just wrote, and it is worth verifying by
# hand after any permissions change (acceptance test 2 in the runbook).
#
# The dev placeholder below does not exist; the backup service only starts
# under `--profile tools`, and preflight fails with a specific message if
# the key is not readable.
GDRIVE_SA_WRITER_JSON=./secrets/gdrive-backup-writer.json

# ID of the `baja-backups` Google Shared Drive. A Shared Drive, NOT
# anyone's My Drive: it must be org-owned so it survives people leaving.
# Read it out of the Drive URL: drive.google.com/drive/folders/<ID>
GDRIVE_SHARED_DRIVE_ID=

# age PUBLIC keys — both halves of the recipient pair, both applied to
# every artifact.
#
#   ESCROW    private half held OFFLINE by Joao AND Tiago. Never on a
#             server. Used only for the twice-yearly human restore drill
#             and for a real disaster.
#   VERIFIER  private half used by the weekly verify stack on the VPS.
#
# Only public halves (age1...) ever go in this file. backup-db.sh refuses
# to start if it finds an AGE-SECRET-KEY here, or if the two are equal.
AGE_RECIPIENT_ESCROW=
AGE_RECIPIENT_VERIFIER=

# Uptime Kuma push URL for the backup job. Pinged ONLY on full success —
# any failure exits without pinging, and Kuma alerts on the silence.
# Leaving this blank means failures go unnoticed.
KUMA_PUSH_URL_BACKUP=

# Test hooks, blank in normal operation.
#
# BACKUP_REMOTE redirects uploads away from Drive (e.g. `:local:/tmp/x/`)
# and suppresses the Kuma heartbeat so a test run cannot mark the monitor
# healthy. BACKUP_RUN_ID forces the run id, which is the only way to
# exercise the first-of-month and first-of-year branches without waiting
# for the calendar.
BACKUP_REMOTE=
BACKUP_RUN_ID=

# ----- Weekly restore verification (docker-compose.verify.yml) -----
#
# Run by scripts/verify-run.sh from host cron, Tuesdays 04:00. It shares
# the VPS with production; see the guardrails at the top of
# docker-compose.verify.yml before changing any of this.
#
# Root password for the SCRATCH MySQL. It MUST differ from
# MYSQL_ROOT_PASSWORD — that difference is the last thing standing
# between a misconfigured `mysql <` and production, and verify-db.sh
# refuses to run if the two match.
MYSQL_VERIFY_ROOT_PASSWORD=devverifyroot

# Host path to the baja-backup-reader service-account key (Viewer role).
# Read-only on both sides: the Viewer role on the Shared Drive, and
# rclone's drive.readonly scope. The verifier never writes to Drive.
GDRIVE_SA_READER_JSON=./secrets/gdrive-backup-reader.json

# Host path to the verifier age PRIVATE key. This is the one private key
# that legitimately lives on the VPS. The ESCROW private key must never
# appear here or anywhere else on a server.
AGE_IDENTITY_VERIFIER=./secrets/age-verifier.key

# Uptime Kuma push URL for the verify job. Pinged only after verification
# AND teardown have both succeeded — a failed teardown alerts, because
# leaving decrypted competitor data on the production host is worse than
# the failure this job exists to catch.
KUMA_PUSH_URL_VERIFY=

# Absolute floor for baja_resultados.user. Unlike the manifest diff, this
# does not trust the backup: if the backup user silently lost SELECT on a
# table, the manifest would record the wrong count too and the diff would
# pass. Production is in the high hundreds; a dev database has one row, so
# lower this locally rather than in production.
VERIFY_MIN_ROWS_USER=50

# Where the verifier keeps the previous run's schema hashes, so schema
# drift can be reported. Holds hashes only, no data.
VERIFY_STATE_DIR=/var/lib/baja-verify

# Test hook, mirrors BACKUP_REMOTE. Blank in normal operation.
VERIFY_REMOTE=

# ----- Future -----
# Google Analytics tracking ID for the cert page. Empty in dev disables
# tracking. Not yet wired into PHP code; reserved.
# BAJA_GA_TRACKING_ID=
