# Baja SAE Brasil — environment configuration for the docker compose stack.
#
# Quick start:
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Edit it locally; commit only changes to this template.
# The dev defaults below work out of the box for `docker compose up -d`.
# In prod, replace with real production values.
#
# Keep comments on their own line, never trailing an assignment. Compose's
# .env parser only strips a trailing comment when whitespace precedes the `#`:
# `FOO=bar # note` yields `bar`, but `FOO=bar# note` yields the literal
# `bar# note`. Bash's `source` strips neither the same way, so a trailing
# comment can read as correct in a shell and be wrong inside the container,
# and the whitespace rule has varied across Compose versions. A comment on its
# own line above the assignment sidesteps all of it.

# ----- Stack environment -----
ENV=dev

# ----- Public-facing domain -----
# What URL the PHP app builds public links from (e.g. cert PDFs).
# In prod: bajasaebrasil.net + https.
BAJA_PUBLIC_DOMAIN=baja.local
BAJA_PUBLIC_SCHEME=http

# ----- phpBB cookie domains -----
# Leading-dot form required to share auth cookies across subdomains.
# Applied by the migration script after each DB import.
BAJA_COOKIE_DOMAIN=.baja.local
FORMULA_COOKIE_DOMAIN=.formula.local

# ----- Code path bind mount -----
# Path to baja-php source tree, relative to baja-infra/. Different if you
# checked the repo out somewhere unusual.
BAJA_APP_PATH=../baja-php

# ----- MySQL credentials -----
# Root password is used by the MySQL container init only. Application-level
# users have their own passwords below.
MYSQL_ROOT_PASSWORD=devrootpass

# `resultados` is the MySQL user the baja-app container connects as. It has
# full grants on baja_resultados AND read access on phpbb_baja (used by the
# session shim — see baja-php/src/Baja/Auth/SessionStore.php). One MySQL
# account, two roles. Compose injects this single value into both
# MYSQL_RESULTADOS_PASSWORD (init-script grants) and PHPBB_DB_PASS (shim
# read path); they're the same secret.
MYSQL_RESULTADOS_PASSWORD=devresultados

# Per-phpBB-instance MySQL users. Each phpBB container connects to its own
# DB as its own user.
#
# config.php is generated at container boot from config.php.template
# (baja-infra/phpbb-baja/ and .../phpbb-formula/) using envsubst, reading
# these values from the live environment. Changing either password below
# only requires recreating the volume — no image rebuild needed:
#     docker compose down -v
#     docker compose up -d
#
MYSQL_PHPBB_BAJA_PASSWORD=devphpbbbaja2
MYSQL_PHPBB_FORMULA_PASSWORD=devphpbbformula2

# ----- phpBB cookie prefixes -----
# The prefix phpBB uses when setting its cookies (<prefix>_sid, _u, _k).
# The migration's patch phase normalizes each forum's DB cookie_name to
# these values (production's imported cookie_name is an incidental random
# string that would otherwise break the baja-app session shim, which reads
# the cookie named by PHPBB_COOKIE_PREFIX). Keep these stable across envs.
# baja forum (also read by the shim)
PHPBB_COOKIE_PREFIX=phpbb3_baja
# formula forum
PHPBB_FORMULA_COOKIE_PREFIX=phpbb3_formula

# Cache TTL for the shim's per-session lookup. Higher = fewer DB queries;
# trade-off is staleness window (admin-killed sessions keep validating
# until expiry). 600s balances this for our threat model (was 60s in
# WP6, bumped here as the team's reassessed call).
SESSION_CACHE_TTL_SECONDS=600

# ----- phpBB auth extension (baja/auth, lives in phpbb-baja) -----
# Suffix the extension accepts as a valid post-login redirect target.
# Anything not ending with this is rejected as off-domain.
BAJA_AUTH_ALLOWED_DOMAIN_SUFFIX=.baja.local

# Where login lands when the redirect param is missing or rejected.
BAJA_AUTH_DEFAULT_REDIRECT=http://baja.local/

# ----- App secrets (baja-app) -----
# Real values required in prod (OneSignal push auth, reCAPTCHA site key,
# the remote key, notification emails). Dev can use any placeholder — these
# code paths are not exercised in dev.
ONESIGNAL_AUTH=
REMOTE_KEY=
RECAPTCHA_KEY=
SYSADMIN_1_EMAIL=
SYSADMIN_2_EMAIL=

# ----- phpBB cron sidecar (staging/prod overlay) -----
# How often the cron sidecars run phpBB's periodic tasks. Email queue
# latency is at most this interval. 300s (5 min) is a sensible default.
CRON_INTERVAL_SECONDS=300

# ----- Tailscale (prod DB access) -----
# The VM's Tailscale interface IP (100.x.y.z). MySQL's 3306 is published
# here in prod so tailnet members can reach it; the public interface never
# sees it. Leave blank in dev (override isn't used there).
TAILSCALE_IP=

# ----- Future -----
# Google Analytics tracking ID for the cert page. Empty in dev disables
# tracking. Not yet wired into PHP code; reserved.
# BAJA_GA_TRACKING_ID=
