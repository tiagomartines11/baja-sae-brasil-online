# Baja SAE Brasil — environment configuration for the docker compose stack.
#
# Quick start:
#   cp .env.example .env
#   docker compose up -d
#
# .env is gitignored. Edit it locally; commit only changes to this template.
# The dev defaults below work out of the box for `docker compose up -d`.
# In prod, replace with real production values.
#
# Keep comments on their own line, never trailing an assignment. Compose's
# .env parser only strips a trailing comment when whitespace precedes the `#`:
# `FOO=bar # note` yields `bar`, but `FOO=bar# note` yields the literal
# `bar# note`. Bash's `source` strips neither the same way, so a trailing
# comment can read as correct in a shell and be wrong inside the container,
# and the whitespace rule has varied across Compose versions. A comment on its
# own line above the assignment sidesteps all of it.

# ----- Stack environment -----
ENV=dev

# Derived from ENV above; there is nothing to set here.
#
# `docker compose` decides which profiled services to start from this variable
# and from this variable only — a service cannot be gated on an arbitrary one,
# so ENV alone cannot do it. Pointing it at ENV means there is still just one
# switch: ENV=dev starts the services tagged `profiles: ["dev"]`, ENV=prod
# starts none of them.
#
# Today that is Mailpit, a throwaway SMTP server with a web inbox at
# http://localhost:8025, so the mail /requerimento sends can be read without a
# real relay. It lives in docker-compose.yml rather than a dev-only overlay
# because the prod overlay is additive and cannot remove a service.
COMPOSE_PROFILES=${ENV}

# ----- Domain and listen mode -----
# One nginx template set serves dev, staging and production; these decide what
# it renders. See baja-infra/nginx/templates/.
#
# They are also what Baja\Url builds public-facing links from (certificate
# PDFs, forum login redirects), so a link can never name a host or a scheme
# nginx is not actually serving. There is deliberately no separate
# BAJA_PUBLIC_DOMAIN / BAJA_PUBLIC_SCHEME pair to fall out of step.
#
# BAJA_DOMAIN is the registrable domain every Baja vhost hangs off — the apex
# plus api./certificado./fila./juiz./resultados./forum. subdomains.
# Production: bajasaebrasil.net. Staging: bajasaebrasil.com.br.
BAJA_DOMAIN=baja.local
#
# FORMULA_DOMAIN is the Formula SAE forum, a separate registrable domain with
# its own certificate lineage. It holds the WHOLE hostname, not a subdomain
# label, because its shape differs per environment: a forum.* subdomain in dev,
# its own apex in production.
FORMULA_DOMAIN=forum.formula.local
#
# LISTEN_MODE picks the listen block every vhost includes: listen-http for dev
# (plain HTTP, no certificates needed anywhere) or listen-tls for staging and
# production (443 + HTTP/2 + certificates under /etc/letsencrypt/live/, and the
# HTTP-to-HTTPS redirect on port 80).
#
# It doubles as the environment's "do we terminate TLS" switch: Baja\Url reads
# it to decide between http:// and https://.
LISTEN_MODE=listen-http

# ----- phpBB cookie domains -----
# Leading-dot form required to share auth cookies across subdomains.
# Applied by the migration script after each DB import.
BAJA_COOKIE_DOMAIN=.baja.local
FORMULA_COOKIE_DOMAIN=.formula.local

# ----- Code path bind mount -----
# Path to baja-php source tree, relative to baja-infra/. Different if you
# checked the repo out somewhere unusual.
BAJA_APP_PATH=../baja-php

# ----- MySQL credentials -----
# Root password is used by the MySQL container init only. Application-level
# users have their own passwords below.
MYSQL_ROOT_PASSWORD=devrootpass

# `resultados` is the MySQL user the baja-app container connects as. It has
# full grants on baja_resultados AND read access on phpbb_baja (used by the
# session shim — see baja-php/src/Baja/Auth/SessionStore.php). One MySQL
# account, two roles. Compose injects this single value into both
# MYSQL_RESULTADOS_PASSWORD (init-script grants) and PHPBB_DB_PASS (shim
# read path); they're the same secret.
MYSQL_RESULTADOS_PASSWORD=devresultados

# Per-phpBB-instance MySQL users. Each phpBB container connects to its own
# DB as its own user.
#
# config.php is generated at container boot from config.php.template
# (baja-infra/phpbb-baja/ and .../phpbb-formula/) using envsubst, reading
# these values from the live environment. Changing either password below
# only requires recreating the volume — no image rebuild needed:
#     docker compose down -v
#     docker compose up -d
#
MYSQL_PHPBB_BAJA_PASSWORD=devphpbbbaja2
MYSQL_PHPBB_FORMULA_PASSWORD=devphpbbformula2

# ----- phpBB cookie prefixes -----
# The prefix phpBB uses when setting its cookies (<prefix>_sid, _u, _k).
# The migration's patch phase normalizes each forum's DB cookie_name to
# these values (production's imported cookie_name is an incidental random
# string that would otherwise break the baja-app session shim, which reads
# the cookie named by PHPBB_COOKIE_PREFIX). Keep these stable across envs.
# baja forum (also read by the shim)
PHPBB_COOKIE_PREFIX=phpbb3_baja
# formula forum
PHPBB_FORMULA_COOKIE_PREFIX=phpbb3_formula

# Cache TTL for the shim's per-session lookup. Higher = fewer DB queries;
# trade-off is staleness window (admin-killed sessions keep validating
# until expiry). 600s balances this for our threat model (was 60s in
# WP6, bumped here as the team's reassessed call).
SESSION_CACHE_TTL_SECONDS=600

# ----- phpBB auth extension (baja/auth, lives in phpbb-baja) -----
# Suffix the extension accepts as a valid post-login redirect target.
# Anything not ending with this is rejected as off-domain.
BAJA_AUTH_ALLOWED_DOMAIN_SUFFIX=.baja.local

# Where login lands when the redirect param is missing or rejected.
BAJA_AUTH_DEFAULT_REDIRECT=http://baja.local/

# ----- App secrets (baja-app) -----
# Real values required in prod (OneSignal push auth, reCAPTCHA site key,
# the remote key, notification emails). Dev can use any placeholder — these
# code paths are not exercised in dev.
ONESIGNAL_AUTH=
REMOTE_KEY=
RECAPTCHA_KEY=
SYSADMIN_1_EMAIL=
SYSADMIN_2_EMAIL=

# Keys the per-document backoff on /buscar (Baja\Certificado\Backoff), which
# counts failed lookups against the document number so that somebody holding a
# CPF cannot sit and guess names against it.
#
# The point of the key is that Redis never holds anything a CPF can be
# recovered from. A plain digest would not do: there are only 10^11 CPFs, so
# the whole space hashes on a laptop and any leaked key reverses by lookup.
# Any long random string works; it never leaves the server and nothing depends
# on its value, so it can be rotated at will — the only effect is that
# in-flight failure counts reset.
#
# Leaving it empty degrades to an unkeyed hash rather than disabling the
# backoff — which is why the dev value below is a value and not a blank: the
# committed test suite asserts the digest is keyed, so an empty default meant
# `tests/certificado/run.php` failed one test on every fresh dev stack. A
# throwaway string is enough to exercise the real path.
#
# PROD: replace with a long random string.
CERT_BACKOFF_SECRET=devbackoffsecret

# ----- Results cache bypass for judges (baja_staff cookie) -----
# The public results pages are cached by Cloudflare. A judge's browser carries
# a baja_staff cookie with this value, set by baja-app for users with judge
# permissions, and a request carrying exactly this value skips the cache and
# is built with the judge's forum session (so a judge in a resultado's
# authorized_users sees past spoilers). See docs/results-caching.md.
#
# Not a credential: someone who copies it without a judge's session just gets
# the public page, uncached. But it is in the Cloudflare cache rule, so keep it
# out of chats and screenshots, or anyone could skip the cache at will.
#
# Letters and digits only, at least 32 of them; baja-app ignores anything else
# and then gives the cookie to nobody. Generate with:
#     openssl rand -hex 24
# Required: compose refuses to start without it.
#
# Rotating it: new value here, then `docker compose up -d baja-app nginx` and
# `docker compose restart nginx`, then the same value in the Cloudflare cache
# rule. Judges get the new cookie on
# their next page in the judge area. The runbook is in docs/results-caching.md.
#
# PROD: replace with a value from the command above.
STAFF_COOKIE_VALUE=devstaffcookie000000000000000000000000000000000

# ----- Certificate requerimentos (/requerimento) -----
# The public form where a participant says a certificate is wrong, missing, or
# should not exist. They are stored in `certificado_requerimento` and read on
# juiz/certificados_requerimentos.php; what goes out by email is a notification
# with a link and none of the participant's data.
#
# Who gets that notification is derived from the `certificados` permission —
# every user holding it, with their address read from the forum. Nothing to
# configure for that. This variable is added to the derived list, never used
# instead of it, and exists for the two cases the derived list cannot cover: a
# shared inbox belonging to no forum account, and a deployment where the phpBB
# read fails. Comma-separated. A requerimento with no recipient is the one
# outcome worth avoiding, because the participant has already been told it
# arrived.
CERT_REPORT_EMAILS=

# Cloudflare Turnstile, the anti-robot check on that form.
#
# Turnstile rather than reCAPTCHA (whose RECAPTCHA_KEY above is dead — nothing
# reads it). reCAPTCHA sets cookies, which would put a consent banner on the
# certificate pages, and ships personal data to a new controller abroad;
# Cloudflare is already in front of every request to this stack, so Turnstile
# adds no recipient that was not already in the path.
#
# Get a pair at dash.cloudflare.com then Turnstile. Both are needed together:
# a site key with no secret renders a widget nothing checks.
#
# DEV: leave both empty, which is what the values below do. The check is then
# skipped entirely, the absence is logged on every render, and the staff
# notification carries a line saying the submission was not verified — so dev
# never silently pretends to have a captcha. It is keyed on the variables being
# unset, not on ENV: an ENV-keyed bypass is a bypass that ships the day ENV is
# wrong somewhere.
#
# To exercise the widget locally instead, Cloudflare publishes dummy sitekey /
# secret pairs that always pass, always fail, or always challenge, on any
# hostname including localhost. They are listed under "Testing" in the
# Turnstile docs; paste a pair here rather than a real key, because a real
# sitekey is bound to a hostname and will not render on baja.local.
#
# PROD: set both. Required.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Where SAE BRASIL's Aviso de Privacidade is published, as an absolute
# https:// URL.
#
# The certificate pages link it in three places: the footer of every public
# page (/buscar, /verificar/{token} and /requerimento), the "como os seus dados
# serão tratados" box on the /requerimento form, and the confirmation email a
# requerimento sends to the participant. Empty hides the link in all three —
# the pages then say nothing about a notice, rather than link to a page that
# does not exist.
#
# Anything that is not an absolute https:// URL (http://, a relative path, a
# javascript: scheme, a typo) is treated as empty and logged once by baja-app,
# because the value ends up in an href on a public page and in an email body.
#
# DEV: empty is fine.
#
# STAGING and PROD: set it, both to SAE BRASIL's published Aviso de
# Privacidade. The same document in both, because both describe the same
# processing of the same data.
PRIVACY_NOTICE_URL=

# ----- Outbound mail (baja-app) -----
# Used by Baja\Util\Mailer, which is SMTP-only: the app image is
# php:8.3-fpm-alpine with no sendmail binary, so mail() has never worked here.
# Separate from phpBB's mailer on purpose — the certificate vhost runs with
# SKIP_AUTH precisely so it does not depend on the forum.
#
# SMTP_FROM_EMAIL must be an address the relay is authorised to send as, or
# SPF and DMARC will bin the message at the recipient. That is the thing most
# likely to be wrong the first time this is switched on, and it is a DNS
# question, not a code one.
#
# SMTP_SECURITY: tls (STARTTLS, the default), ssl (implicit TLS, port 465), or
# none. "none" is only defensible for a relay on the same private network —
# these messages carry a participant's name, and LGPD Art. 46 asks for the
# transfer to be protected.
#
# An empty SMTP_USER means "do not authenticate", for a relay that takes no
# credentials.
#
# SMTP_FROM_EMAIL is also the address participants reply to: the certificate
# pages no longer print a contact address anywhere, so the confirmation this
# sends is the only reply-able end of the conversation, and it is where a
# request to correct or delete report data will arrive. It has to be a mailbox
# somebody actually reads — not a no-reply.
#
# Nothing breaks if this is all unset: /requerimento still accepts and stores
# the requerimento, tells the person plainly that no confirmation is coming, and
# leaves the row with avisado_em null so the staff queue flags it. What is lost
# is the notification, not the requerimento.
#
# DEV: the values below point at the Mailpit container in docker-compose.yml,
# which needs COMPOSE_PROFILES=dev (above) to be running. It accepts anything,
# delivers nothing, and shows every message at http://localhost:8025 — so both
# emails a submission sends can be read end to end without a real relay. Plain
# SMTP on a container network, hence SMTP_SECURITY=none.
#
# PROD: replace all of these with the real relay, and use tls.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURITY=none
SMTP_FROM_EMAIL=certificados@baja.local
SMTP_FROM_NAME=SAE BRASIL - Certificados

# ----- API foundation (baja-app, api.* vhost) -----
# Exact-match CORS whitelist for the PHP API, comma-separated. No patterns,
# no wildcards, and an empty value allows nothing — it fails closed.
#
# This is not optional. The API is on its own subdomain (api.baja.local) per
# the *.domain = PHP convention, so every call from the frontend is
# cross-origin. An empty list means the browser blocks all of them.
#
# Exact origins rather than a wildcard is forced by the spec: Cors sends
# Access-Control-Allow-Credentials so the phpBB session cookie flows, and
# credentialed requests may not be paired with `*`.
#
# Dev defaults below cover the local subdomains. In prod:
#   https://bajasaebrasil.com.br,https://www.bajasaebrasil.com.br
API_CORS_ORIGINS=http://baja.local,http://www.baja.local,http://resultados.baja.local,http://juiz.baja.local,http://fila.baja.local

# Master key for Baja\Util\Encryption (libsodium secretbox), base64 of 32
# random bytes. Generate with:
#     php -r "echo base64_encode(random_bytes(32));"
# Required in prod. Unset in dev until a feature actually encrypts something —
# Encryption throws rather than falling back to a default key, by design.
# Rotating this makes every existing ciphertext undecryptable; there is no
# key-versioning scheme yet, so treat it as write-once until FP8 adds one.
STORAGE_ENCRYPTION_KEY=

# Minimum log level for Baja\Logger: debug|info|notice|warning|error|critical.
# Blank uses the environment default (debug in dev, info in prod). Records go
# to stdout as JSON — read them with `docker compose logs baja-app`.
LOG_LEVEL=

# ----- phpBB cron sidecar (staging/prod overlay) -----
# How often the cron sidecars run phpBB's periodic tasks. Email queue
# latency is at most this interval. 300s (5 min) is a sensible default.
CRON_INTERVAL_SECONDS=300

# ----- Tailscale (prod DB access) -----
# The VM's Tailscale interface IP (100.x.y.z). MySQL's 3306 is published
# here in prod so tailnet members can reach it; the public interface never
# sees it. Leave blank in dev (override isn't used there).
TAILSCALE_IP=

# ----- Encrypted database backups (`backup` service, tools profile) -----
#
# Full documentation, including how to restore, lives in
# baja-infra/docs/backup-restore.md. Read it before changing anything here.
#
# The restricted MySQL user backup-db.sh connects as. Created by
# mysql/init/02-create-users.sh on FIRST BOOT ONLY — on an already
# initialised server (production) the GRANT has to be applied by hand;
# the runbook has the exact statement. It has no write privilege on any
# database, by design.
MYSQL_BACKUP_USER=backup
MYSQL_BACKUP_PASSWORD=devbackup

# Path on the HOST to the baja-backup-writer service-account key.
#
# Note this variable is used two ways: compose bind-mounts this host path
# into the container, where the same variable name is set to the fixed
# in-container path (/run/secrets/gdrive-backup-writer.json). You only
# ever set the host side here.
#
# baja-backup-writer must be a CONTRIBUTOR on the Shared Drive — able to
# upload, unable to trash. That property is what stops a compromised VPS
# from deleting the backups it just wrote, and it is worth verifying by
# hand after any permissions change (acceptance test 2 in the runbook).
#
# The dev placeholder below does not exist; the backup service only starts
# under `--profile tools`, and preflight fails with a specific message if
# the key is not readable.
GDRIVE_SA_WRITER_JSON=./secrets/gdrive-backup-writer.json

# ID of the `baja-backups` Google Shared Drive. A Shared Drive, NOT
# anyone's My Drive: it must be org-owned so it survives people leaving.
# Read it out of the Drive URL: drive.google.com/drive/folders/<ID>
GDRIVE_SHARED_DRIVE_ID=

# age PUBLIC keys — both halves of the recipient pair, both applied to
# every artifact.
#
#   ESCROW    private half held OFFLINE by two maintainers, separately. Never on a
#             server. Used only for the twice-yearly human restore drill
#             and for a real disaster.
#   VERIFIER  private half used by the weekly verify stack on the VPS.
#
# THIS FILE ITSELF is backed up every night it has changed, encrypted to the
# ESCROW key alone, to secrets/<run_id>/ on the Shared Drive; nothing on the
# server can read that copy. See "Secrets" in docs/backup-restore.md.
#
# Only public halves (age1...) ever go in this file. backup-db.sh refuses
# to start if it finds an AGE-SECRET-KEY here, or if the two are equal.
AGE_RECIPIENT_ESCROW=
AGE_RECIPIENT_VERIFIER=

# Uptime Kuma push URL for the backup job. Pinged ONLY on full success —
# any failure exits without pinging, and Kuma alerts on the silence.
# Leaving this blank means failures go unnoticed.
KUMA_PUSH_URL_BACKUP=

# Test hooks, blank in normal operation.
#
# BACKUP_REMOTE redirects uploads away from Drive (e.g. `:local:/tmp/x/`)
# and suppresses the Kuma heartbeat so a test run cannot mark the monitor
# healthy. BACKUP_RUN_ID forces the run id, which is the only way to
# exercise the first-of-month and first-of-year branches without waiting
# for the calendar.
#
# To try the whole job on the dev stack without Google, set
#   BACKUP_REMOTE=:local:/drive/
# and the run lands on the host in BACKUP_LOCAL_DRIVE below.
BACKUP_REMOTE=
BACKUP_RUN_ID=

# Host folder the backup container sees as /drive, the destination of
# BACKUP_REMOTE=:local:/drive/. Gitignored. Unused in production.
BACKUP_LOCAL_DRIVE=./backup-local/drive

# Host folder holding the LGPD erasure log (scripts/erasure-log.sh). It
# CONTAINS PERSONAL DATA and is append-only; see "Erasure log" in
# docs/backup-restore.md for how to create it. The backup service mounts it
# read-only and backs it up encrypted every night; only the erasure-log
# service can write to it.
#
# PROD and STAGING: /srv/baja/erasure. DEV: the gitignored folder below.
ERASURE_LOG_DIR=./backup-local/erasure

# Uptime Kuma push URL for the event archives (BAJAAPP-67). backup-run.sh
# pings it every night once the queue of pending archives has been worked
# through with no failure, including the common night when it is empty. A
# request that keeps failing therefore alerts every night until fixed.
KUMA_PUSH_URL_ARCHIVE=

# Host folder where backup-run.sh hands an event's results snapshots from
# the baja-app container to the backup container. Emptied after each one.
# The snapshots are published results, but they are still removed.
BACKUP_HOST_WORK_DIR=/var/tmp/baja-backup-host

# ----- Weekly restore verification (docker-compose.verify.yml) -----
#
# Run by scripts/verify-run.sh from host cron, Tuesdays 04:00. It shares
# the VPS with production; see the guardrails at the top of
# docker-compose.verify.yml before changing any of this.
#
# Root password for the SCRATCH MySQL. It MUST differ from
# MYSQL_ROOT_PASSWORD — that difference is the last thing standing
# between a misconfigured `mysql <` and production, and verify-db.sh
# refuses to run if the two match.
MYSQL_VERIFY_ROOT_PASSWORD=devverifyroot

# Host path to the baja-backup-reader service-account key (Viewer role).
# Read-only on both sides: the Viewer role on the Shared Drive, and
# rclone's drive.readonly scope. The verifier never writes to Drive.
GDRIVE_SA_READER_JSON=./secrets/gdrive-backup-reader.json

# Host path to the verifier age PRIVATE key. This is the one private key
# that legitimately lives on the VPS. The ESCROW private key must never
# appear here or anywhere else on a server.
AGE_IDENTITY_VERIFIER=./secrets/age-verifier.key

# Uptime Kuma push URL for the verify job. Pinged only after verification
# AND teardown have both succeeded — a failed teardown alerts, because
# leaving decrypted competitor data on the production host is worse than
# the failure this job exists to catch.
KUMA_PUSH_URL_VERIFY=

# Absolute floor for baja_resultados.user. Unlike the manifest diff, this
# does not trust the backup: if the backup user silently lost SELECT on a
# table, the manifest would record the wrong count too and the diff would
# pass. Production is in the high hundreds; a dev database has one row, so
# lower this locally rather than in production.
VERIFY_MIN_ROWS_USER=50

# Where the verifier keeps the previous run's schema hashes, so schema
# drift can be reported. Holds hashes only, no data.
VERIFY_STATE_DIR=/var/lib/baja-verify

# Test hook, mirrors BACKUP_REMOTE. Blank in normal operation.
VERIFY_REMOTE=

# ----- Future -----
# Google Analytics tracking ID for the cert page. Empty in dev disables
# tracking. Not yet wired into PHP code; reserved.
# BAJA_GA_TRACKING_ID=
