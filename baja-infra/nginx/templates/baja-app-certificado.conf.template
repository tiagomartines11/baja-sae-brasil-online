# Rate limiting and log redaction for the certificate vhost.
#
# These are http-context directives, and conf.d files are included inside
# http{}, so they live at the top of this file rather than in nginx.conf.

# Limit POSTs to /buscar only. nginx cannot select a location by method, and an
# empty key is skipped by limit_req, so mapping GET to "" leaves reads
# unlimited while POSTs are keyed by address.
#
# What this defends changed with the redesign. There is no CPF in a URL to
# enumerate any more; what is left is guessing names against a CPF somebody
# already has. Per-document backoff in Redis covers that dimension — see
# Baja\Certificado\Backoff — and this covers the address dimension. An
# attacker with a pool of addresses defeats this one and not that one.
# Keyed on method and URI together, and matched after the internal rewrite —
# "rewrite ... last" restarts location matching, so a limit_req sitting in the
# "location = /buscar" block would never be reached. Hence POST:/buscar.php.
# An empty key is skipped by limit_req, so every other request is unlimited.
map "$request_method:$uri" $buscar_limit_key {
    default          "";
    "~^POST:/buscar" $binary_remote_addr;
}
limit_req_zone $buscar_limit_key zone=cert_buscar:1m rate=10r/m;
limit_req_status 429;

# --- access log redaction ---------------------------------------------------
#
# The legacy path carries the participant's CPF in base 16, so writing it to
# the access log copies personal data onto disk on every hit — which is one of
# the things this work package exists to stop.
#
# Redact the whole second path segment rather than trying to match a CPF shape.
# A rule looking for eleven consecutive digits finds nothing here and would
# give false confidence: the value is 8 to 10 hex characters, and its length
# varies with the CPF's magnitude.
map $uri $cert_uri_redacted {
    default                              $uri;
    "~^/c/(?<cert_evt>[a-zA-Z0-9]+)/"    "/c/$cert_evt/[redacted]";
}

# certificado.php took the same values as query parameters, and still answers
# there (with a redirect). Anything carrying a cpf parameter is redacted whole
# rather than picked apart.
map $args $cert_args_redacted {
    default      $args;
    ""           "";
    "~(^|&)cpf=" "[redacted]";
}

# A Referer is just as much a copy: a browser following the link off a legacy
# certificate page sends the whole URL, CPF included.
map $http_referer $cert_referer_redacted {
    default                           $http_referer;
    "~^(?<cert_ref_prefix>.*)/c/[a-zA-Z0-9]+/[a-zA-Z0-9]+" "$cert_ref_prefix/c/[redacted]";
}

# Re-attach the "?" only when there is a query string, so ordinary requests do
# not all get a dangling one in the log.
map $cert_args_redacted $cert_args_suffix {
    default "?$cert_args_redacted";
    ""      "";
}

log_format certificado_redacted
    '$remote_addr - $remote_user [$time_local] '
    '"$request_method $cert_uri_redacted$cert_args_suffix $server_protocol" '
    '$status $body_bytes_sent "$cert_referer_redacted" "$http_user_agent"';

server {
    include /etc/nginx/conf.d/snippets/${LISTEN_MODE}.conf;
    server_name certificado.${BAJA_DOMAIN};

    # Emit relative Location headers. The legacy redirect is the only one
    # that matters here, and an absolute URL built from $scheme and $host
    # is a chance to send somebody to the wrong scheme from behind a proxy.
    absolute_redirect off;

    access_log /var/log/nginx/access.log certificado_redacted;

    root /var/www/baja-app/certificado;
    index index.php index.html;

    # Shared css js and img folders
    location /css/ {
        alias /var/www/baja-app/default/css/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location /js/ {
        alias /var/www/baja-app/default/js/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # /buscar — the lookup form, and the only place a document number is ever
    # accepted. GET renders it, POST answers in the same response; there is no
    # redirect, because the document number cannot go in a URL.
    location = /buscar {
        rewrite ^ /buscar.php last;
    }

    # /verificar/{token}      -> confirmation page
    # /verificar/{token}/pdf  -> the certificate
    #
    # The token character class is base64url and the length is exact, so a
    # malformed token is a 404 from nginx and never reaches PHP. verificar.php
    # re-checks anyway; neither check is the only one.
    #
    # Both regexes are quoted because they contain {22}: nginx reads an
    # unquoted brace as the start of a block and refuses to start.
    location ~ "^/verificar/([A-Za-z0-9_-]{22})$" {
        rewrite "^/verificar/([A-Za-z0-9_-]{22})$" /verificar.php?token=$1 last;
    }

    location ~ "^/verificar/([A-Za-z0-9_-]{22})/pdf$" {
        rewrite "^/verificar/([A-Za-z0-9_-]{22})/pdf$" /verificar.php?token=$1&format=pdf last;
    }

    # Anything else under /verificar/ is a malformed token — wrong length, or
    # characters outside base64url. It gets the same not-found page an unknown
    # but well-formed token gets, because the two must be indistinguishable.
    # A regex location rather than "^~", which would take precedence over the
    # two above and swallow every valid token with them.
    location ~ "^/verificar/" {
        rewrite ^ /verificar.php?token= last;
    }

    # Legacy certificate URL, printed on every certificate ever issued. The
    # second path segment is the participant's CPF in base 16, which is why
    # this answers with a redirect and never with a certificate: resolving it
    # would keep the CPF-to-name oracle alive, and that is what this work
    # package exists to remove.
    #
    # Handled here rather than in PHP so the CPF is never handed to the
    # application at all. certificado.php redirects too, as a backstop for the
    # POST and ?evt=&cpf= shapes and for the day this block gets edited.
    #
    # No query string on the target: "return 302 /buscar" does not append the
    # original arguments, which is the point — passing the CPF along to
    # prefill the form would put it straight back into a URL.
    location ~ "^/c/([a-zA-Z0-9]+)/([a-zA-Z0-9]+)$" {
        return 302 /buscar;
    }
    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        # Only bites on POST /buscar; $buscar_limit_key is empty for everything
        # else, and limit_req skips empty keys. 10/min per address with a small
        # burst is generous for a human filling in a form and useless for
        # grinding names against a document somebody already holds.
        limit_req zone=cert_buscar burst=5 nodelay;

        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_pass baja-app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/certificado$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # No phpBB session on this vhost: it is public and unauthenticated, and
        # without this every certificate lookup paid for session setup against
        # the forum, coupling certificate availability to it. Since b158ed6 this
        # flag no longer affects error display, which is decided from ENV.
        fastcgi_param SKIP_AUTH 1;
        fastcgi_param PHP_VALUE "auto_prepend_file=/var/www/html/src/bootstrap.php";
        fastcgi_param QUERY_STRING $args;
    }
}
