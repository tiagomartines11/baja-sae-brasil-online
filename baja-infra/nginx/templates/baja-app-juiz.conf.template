server {
    include /etc/nginx/conf.d/snippets/${LISTEN_MODE}.conf;
    server_name juiz.${BAJA_DOMAIN};

    root /var/www/baja-app/juiz;
    index index.php index.html;

    # CORS for cross-subdomain requests. Matches the base domain and any of
    # its subdomains.
    #
    # The dots in ${BAJA_DOMAIN} render unescaped, so each one matches any
    # single character rather than a literal ".". That admits a host differing
    # from the real one only at those separator positions — which, having no
    # real TLD boundary, is not a name anybody can register. The check still
    # accepts only the true domain and its subdomains in practice. Escaping
    # would need a second variable holding a regex-quoted copy of the same
    # value: one more thing to keep in step, and that drift is what this work
    # package exists to remove.
    set $cors_origin "";
    if ($http_origin ~* "^https?://([a-z0-9-]+\.)?${BAJA_DOMAIN}(:\d+)?$") {
        set $cors_origin $http_origin;
    }
    add_header Access-Control-Allow-Origin $cors_origin always;
    add_header Vary Origin always;

    # Shared css js and img folders
    location /css/ {
        alias /var/www/baja-app/default/css/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location /js/ {
        alias /var/www/baja-app/default/js/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    location /img/ {
        alias /var/www/baja-app/default/img/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Event-prefixed URL rewrites: /25BR -> /25BR/ (301), /25BR/foo -> /foo with EVENT=25BR
    location ~ "^/([0-2][0-9](BR|SE|SU|NE))$" {
        return 301 /$1/;
    }

    location ~ "^/([0-2][0-9](BR|SE|SU|NE))/(.*)$" {
        set $event_code $1;
        rewrite ^/([0-2][0-9](BR|SE|SU|NE))/(.*)$ /$3 last;
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location / {
        try_files $uri $uri/ /index.php$is_args$args;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.*)$;
        fastcgi_pass baja-app:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/html/juiz$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        # max_input_vars is raised from PHP's stock 1000 for the certificate
        # paste flow. Its review screen posts one resolution per row needing a
        # decision, and a sheet pasted twice makes every one of its rows a
        # duplicate — so a 2,000-row paste can legitimately carry a few
        # thousand inputs. At the default, PHP drops everything past the
        # thousandth and warns to the log, which would commit a batch with
        # most of the operator's answers silently missing.
        #
        # Newline-separated, which is how PHP-FPM reads more than one setting
        # out of PHP_VALUE. auto_prepend_file stays first: without it no page
        # on this vhost boots at all.
        fastcgi_param PHP_VALUE "auto_prepend_file=/var/www/html/src/bootstrap.php
                                 max_input_vars=10000";
        fastcgi_param REDIRECT_EVENT $event_code;
    }
}
