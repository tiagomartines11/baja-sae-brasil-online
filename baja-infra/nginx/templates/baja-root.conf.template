server {
    # The -default snippet claims the fallback for any request whose Host
    # header doesn't match a server_name in any conf — e.g. http://localhost/.
    # Without it nginx falls back to the alphabetically-first conf
    # (baja-app-certificado.conf), which is surprising during local dev.
    # In a TLS environment this is the default_server on 443; the one on 80 is
    # the redirect. Exactly one per port, which is why the snippet is separate.
    include /etc/nginx/conf.d/snippets/${LISTEN_MODE}-default.conf;
    server_name ${BAJA_DOMAIN};

    # The PHP API lives on its own vhost (baja-app-api.conf), per the
    # convention that *.${BAJA_DOMAIN} is PHP and the apex path space is
    # Next.js. /api/ here stays free for Next.js route handlers.

    # Everything else: proxy to Next.js (baja-js container, port 3000).
    # The /css /js /img location blocks above must remain BEFORE this one —
    # Next.js does not have those legacy paths and would 404 them.
    location / {
        # $backend_baja_js is baja-js:3000, looked up per request (see
        # 00-backends.conf). No URI after it, so the request URI goes to
        # Next.js unchanged, as before.
        #
        # A variable here turns off nginx's implicit `proxy_redirect default`,
        # which would rewrite a Location header starting with
        # http://baja-js:3000/. Nothing needs it: Host is passed through
        # below, so Next.js builds absolute URLs from the visitor's hostname,
        # never from baja-js:3000, and baja-js has no redirects of its own.
        proxy_pass http://$backend_baja_js;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Websocket upgrade (HMR in dev; harmless in prod).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
