# TLS for Formula SAE Brasil, which is a separate registrable domain from Baja
# with its own certificate lineage — hence its own snippet rather than a reuse
# of listen-tls.conf.template.
listen 443 ssl;
http2 on;

ssl_certificate     /etc/letsencrypt/live/${FORMULA_DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${FORMULA_DOMAIN}/privkey.pem;
