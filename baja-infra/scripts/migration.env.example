# Migration secrets for migrate.sh — production-side credentials and paths.
#
# Quick start (on the staging VM):
#   cp migration.env.example migration.env
#   chmod 600 migration.env
#   # ...fill in real values, then:
#   sudo -E ./migrate.sh preflight
#
# migration.env is gitignored. Only the cookie-domain / public-domain /
# staging MYSQL_ROOT_PASSWORD values come from baja-infra/.env — do NOT
# duplicate them here.
#
# All paths are ABSOLUTE because the script is typically invoked under sudo,
# where ~ resolves to /root and breaks key lookups.

# ----- Production access (over Tailscale; strictly read-only) -----
PROD_TAILSCALE_IP=            # e.g. 100.x.y.z — the prod node's tailnet IP
PROD_SSH_USER=ubuntu
PROD_SSH_KEY=/home/baja/.ssh/id_production

# ----- Production MySQL credentials -----
# Per-database user+password. Prod's root user does NOT have access to the
# phpBB databases, so we authenticate as each DB's own user for mysqldump.
# Each user needs at least SELECT, LOCK TABLES, and SHOW VIEW on its DB
# (standard phpBB install grants are sufficient; the `--routines --triggers`
# flags will silently dump nothing if the user lacks PROC/TRIGGER privs,
# which is fine for phpBB — neither schema uses them).
PROD_BAJA_RESULTADOS_USER=
PROD_BAJA_RESULTADOS_PASSWORD=
PROD_BAJA_FORUM_USER=
PROD_BAJA_FORUM_PASSWORD=
PROD_FORMULA_USER=
PROD_FORMULA_PASSWORD=

# ----- Production DB names -----
# Defaults match the historical prod setup. Override only if a DB has been
# renamed on prod. The staging-side target names are NOT configurable — the
# new stack expects baja_resultados / phpbb_baja / phpbb_formula.
PROD_BAJA_RESULTADOS_DB=baja_resultados
PROD_BAJA_FORUM_DB=baja_forum
PROD_FORMULA_DB=formula

# ----- Production filesystem paths (phpBB instances) -----
PROD_BAJA_FORUM_PATH=/var/www/forum
PROD_FORMULA_FORUM_PATH=/var/www/formula

# ----- Staging-specific values applied to the imported phpBB data -----
# The host phpBB believes it runs on, for link generation. Per-forum.
STAGING_BAJA_FORUM_DOMAIN=forum.bajasaebrasil.com.br
STAGING_FORMULA_FORUM_DOMAIN=mb3.com.br

# ----- Local working dir for dump files -----
# Holds production PII (names, emails, CPF). Script enforces 0700 perms.
# Must be outside the repo tree (defaults to /srv/baja/migration-work).
WORK_DIR=/srv/baja/migration-work
